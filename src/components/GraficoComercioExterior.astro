---
const socios = [
  {
    pais: "China",
    porcentaje: 35.1,
    monto: "32,670 M",
    color: "#8C3B2B",
    colorHover: "#722E21",
    detalle: "Principal socio comercial; alta exposición a demanda de minerales.",
  },
  {
    pais: "Estados Unidos",
    porcentaje: 10.9,
    monto: "10,145 M",
    color: "#24476E",
    colorHover: "#1B3654",
    detalle: "Segundo socio bilateral clave en manufacturas y agroexportación.",
  },
  {
    pais: "India",
    porcentaje: 6.8,
    monto: "6,329 M",
    color: "#6E5A3E",
    colorHover: "#574730",
    detalle: "Destino relevante de oro y minerales metálicos.",
  },
  {
    pais: "Canadá",
    porcentaje: 5.4,
    monto: "5,026 M",
    color: "#8A7356",
    colorHover: "#705C43",
    detalle: "Comercio concentrado en minería y metales preciosos.",
  },
  {
    pais: "Bolivia",
    porcentaje: 3.9,
    monto: "3,630 M",
    color: "#A69072",
    colorHover: "#8B775C",
    detalle: "Socio regional clave en manufacturas y combustibles.",
  },
];

const escalaMax = 40;
const nivelesY = [40, 30, 20, 10, 0];
---

<figure class="grafico-bcrp-wrapper" aria-label="Participación porcentual en las exportaciones peruanas según el BCRP">
  <div class="grafico-header">
    <p class="grafico-subtitulo">
      Participación porcentual en las exportaciones peruanas, según el BCRP.
    </p>
    <div class="grafico-tooltip-bar" id="bcrp-info-bar" aria-live="polite">
      <span class="info-dot" id="bcrp-info-dot" style="background: #8C3B2B;"></span>
      <span class="info-pais">China</span>
      <span class="info-sep">·</span>
      <span class="info-valor">35,1 % (US$ 32.670 M)</span>
    </div>
  </div>

  <div class="grafico-area">
    <!-- Eje Y y líneas guía punteadas -->
    <div class="eje-y-grid" aria-hidden="true">
      {nivelesY.map((nivel) => (
        <div class="linea-nivel">
          <span class="etiqueta-y">{nivel}%</span>
          <div class="linea-punteada"></div>
        </div>
      ))}
    </div>

    <!-- Barras verticales -->
    <div class="barras-contenedor">
      {socios.map((socio, index) => {
        const alturaPct = (socio.porcentaje / escalaMax) * 100;
        const pctFormato = socio.porcentaje.toFixed(1).replace(".", ",");
        return (
          <button
            type="button"
            class={`barra-columna ${index === 0 ? "is-active" : ""}`}
            data-pais={socio.pais}
            data-porcentaje={`${pctFormato} %`}
            data-monto={`US$ ${socio.monto}`}
            data-color={socio.color}
            aria-label={`${socio.pais}: ${pctFormato} % (US$ ${socio.monto})`}
          >
            <div class="barra-track">
              <div
                class="barra-fill"
                style={`height: ${alturaPct}%; --bar-color: ${socio.color}; --bar-hover: ${socio.colorHover};`}
              >
                <span class="barra-valor-flotante">{pctFormato} %</span>
              </div>
            </div>
            <span class="etiqueta-x">{socio.pais}</span>
          </button>
        );
      })}
    </div>
  </div>

  <figcaption class="grafico-fuente">
    Fuente: Banco Central de Reserva del Perú (BCRP). Total exportado: US$ 93.078 millones. Pasa el cursor o selecciona un país para ver el detalle.
  </figcaption>
</figure>

<script>
  const columnas = document.querySelectorAll<HTMLButtonElement>(".barra-columna");
  const infoBar = document.getElementById("bcrp-info-bar");
  const infoDot = document.getElementById("bcrp-info-dot");

  if (columnas.length && infoBar) {
    const infoPais = infoBar.querySelector(".info-pais");
    const infoValor = infoBar.querySelector(".info-valor");

    const actualizarSeleccion = (btn: HTMLButtonElement) => {
      columnas.forEach((c) => c.classList.remove("is-active"));
      btn.classList.add("is-active");
      if (infoPais && infoValor) {
        infoPais.textContent = btn.dataset.pais ?? "";
        infoValor.textContent = `${btn.dataset.porcentaje} (${btn.dataset.monto})`;
      }
      if (infoDot && btn.dataset.color) {
        infoDot.style.background = btn.dataset.color;
      }
    };

    columnas.forEach((btn) => {
      btn.addEventListener("mouseenter", () => actualizarSeleccion(btn));
      btn.addEventListener("focus", () => actualizarSeleccion(btn));
      btn.addEventListener("click", () => actualizarSeleccion(btn));
    });
  }
</script>

<style>
  .grafico-bcrp-wrapper {
    margin: 2.5rem 0;
    padding: 1.65rem 1.75rem 1.25rem;
    background: #fcfaf5;
    border: 1px solid #e6dfd1;
    border-radius: 12px;
    font-family: inherit;
  }

  .grafico-header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 2.2rem;
  }

  .grafico-subtitulo {
    margin: 0;
    font-size: 0.94rem;
    color: #4a4238;
    font-weight: 400;
  }

  .grafico-tooltip-bar {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.85rem;
    background: #f3ede0;
    border: 1px solid #dfd5c3;
    color: #2c251d;
    border-radius: 999px;
    font-size: 0.84rem;
    font-weight: 500;
    line-height: 1.2;
  }

  .info-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .info-pais {
    font-weight: 600;
  }

  .info-sep {
    opacity: 0.45;
  }

  .grafico-area {
    position: relative;
    height: 250px;
    padding-left: 3rem;
    margin-bottom: 2.35rem;
    user-select: none;
  }

  /* Grid horizontal punteado */
  .eje-y-grid {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    pointer-events: none;
  }

  .linea-nivel {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    height: 0;
  }

  .etiqueta-y {
    width: 2.25rem;
    text-align: right;
    font-size: 0.82rem;
    color: #786d5f;
    font-variant-numeric: tabular-nums;
  }

  .linea-punteada {
    flex: 1;
    border-bottom: 1px dashed #e2d9c8;
  }

  /* Contenedor de barras */
  .barras-contenedor {
    position: relative;
    z-index: 1;
    height: 100%;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: clamp(0.65rem, 2.2vw, 1.4rem);
    align-items: end;
    padding: 0 0.5rem;
  }

  .barra-columna {
    appearance: none;
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    cursor: pointer;
    position: relative;
  }

  .barra-track {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }

  .barra-fill {
    width: 100%;
    max-width: 108px;
    background: var(--bar-color);
    border-radius: 8px 8px 3px 3px;
    position: relative;
    transition: background-color 0.2s ease, transform 0.2s ease, opacity 0.2s ease;
    opacity: 0.92;
  }

  .barra-columna:hover .barra-fill,
  .barra-columna:focus-visible .barra-fill,
  .barra-columna.is-active .barra-fill {
    background: var(--bar-hover);
    opacity: 1;
    transform: translateY(-2px);
  }

  .barra-valor-flotante {
    position: absolute;
    top: -1.5rem;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.8rem;
    font-weight: 600;
    color: #2c251d;
    opacity: 0;
    transition: opacity 0.18s ease;
    white-space: nowrap;
  }

  .barra-columna:hover .barra-valor-flotante,
  .barra-columna:focus-visible .barra-valor-flotante,
  .barra-columna.is-active .barra-valor-flotante {
    opacity: 1;
  }

  .etiqueta-x {
    position: absolute;
    top: calc(100% + 0.65rem);
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.86rem;
    color: #4a4238;
    white-space: nowrap;
    font-weight: 400;
  }

  .barra-columna.is-active .etiqueta-x {
    color: #1f1a14;
    font-weight: 600;
  }

  .grafico-fuente {
    margin-top: 0.75rem;
    padding-top: 0.85rem;
    border-top: 1px solid #e8e0d0;
    font-size: 0.78rem;
    color: #786d5f;
    line-height: 1.45;
  }

  @media (max-width: 600px) {
    .grafico-bcrp-wrapper {
      padding: 1.25rem 1rem 1rem;
    }

    .grafico-area {
      height: 215px;
      padding-left: 2.5rem;
    }

    .etiqueta-x {
      font-size: 0.74rem;
    }

    .barra-fill {
      border-radius: 6px 6px 2px 2px;
    }
  }
</style>