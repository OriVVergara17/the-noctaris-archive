---
const socios = [
  {
    pais: "China",
    porcentaje: 35.1,
    monto: "32,670 M",
    detalle: "Principal socio comercial (cobre, hierro y harina de pescado)",
  },
  {
    pais: "Estados Unidos",
    porcentaje: 11.2,
    monto: "10,425 M",
    detalle: "Agroexportación, oro y textiles",
  },
  {
    pais: "India",
    porcentaje: 6.8,
    monto: "6,329 M",
    detalle: "Oro y minerales metálicos",
  },
  {
    pais: "Canadá",
    porcentaje: 5.4,
    monto: "5,026 M",
    detalle: "Minería y metales preciosos",
  },
  {
    pais: "Bolivia",
    porcentaje: 3.9,
    monto: "3,630 M",
    detalle: "Manufacturas, combustibles y alimentos",
  },
];

const escalaMax = 40;
const nivelesY = [40, 30, 20, 10, 0];
---

<figure class="grafico-bcrp-wrapper" aria-label="Participación porcentual en las exportaciones peruanas según el BCRP">
  <div class="grafico-header">
    <p class="grafico-subtitulo">
      Participación porcentual en las exportaciones peruanas, según el BCRP.
    </p>
    <div class="grafico-tooltip-bar" id="bcrp-info-bar" aria-live="polite">
      <span class="info-pais">China</span>
      <span class="info-sep">·</span>
      <span class="info-valor">35.1% (US$ 32,670 M)</span>
    </div>
  </div>

  <div class="grafico-area">
    <!-- Eje Y y líneas guía punteadas -->
    <div class="eje-y-grid" aria-hidden="true">
      {nivelesY.map((nivel) => (
        <div class="linea-nivel">
          <span class="etiqueta-y">{nivel}%</span>
          <div class="linea-punteada"></div>
        </div>
      ))}
    </div>

    <!-- Barras verticales -->
    <div class="barras-contenedor">
      {socios.map((socio, index) => {
        const alturaPct = (socio.porcentaje / escalaMax) * 100;
        return (
          <button
            type="button"
            class={`barra-columna ${index === 0 ? "is-active" : ""}`}
            data-pais={socio.pais}
            data-porcentaje={`${socio.porcentaje}%`}
            data-monto={`US$ ${socio.monto}`}
            aria-label={`${socio.pais}: ${socio.porcentaje}% (US$ ${socio.monto})`}
          >
            <div class="barra-track">
              <div
                class="barra-fill"
                style={`height: ${alturaPct}%;`}
              >
                <span class="barra-valor-flotante">{socio.porcentaje}%</span>
              </div>
            </div>
            <span class="etiqueta-x">{socio.pais}</span>
          </button>
        );
      })}
    </div>
  </div>

  <figcaption class="grafico-fuente">
    Fuente: Banco Central de Reserva del Perú (BCRP). Total exportado: US$ 93,078 millones. Pasa el cursor o selecciona un país para ver el detalle.
  </figcaption>
</figure>

<script>
  const columnas = document.querySelectorAll<HTMLButtonElement>(".barra-columna");
  const infoBar = document.getElementById("bcrp-info-bar");

  if (columnas.length && infoBar) {
    const infoPais = infoBar.querySelector(".info-pais");
    const infoValor = infoBar.querySelector(".info-valor");

    const actualizarSeleccion = (btn: HTMLButtonElement) => {
      columnas.forEach((c) => c.classList.remove("is-active"));
      btn.classList.add("is-active");
      if (infoPais && infoValor) {
        infoPais.textContent = btn.dataset.pais ?? "";
        infoValor.textContent = `${btn.dataset.porcentaje} (${btn.dataset.monto})`;
      }
    };

    columnas.forEach((btn) => {
      btn.addEventListener("mouseenter", () => actualizarSeleccion(btn));
      btn.addEventListener("focus", () => actualizarSeleccion(btn));
      btn.addEventListener("click", () => actualizarSeleccion(btn));
    });
  }
</script>

<style>
  .grafico-bcrp-wrapper {
    margin: 2.5rem 0;
    padding: 1.75rem 1.75rem 1.25rem;
    background: #fafafa;
    border: 1px solid #ececec;
    border-radius: 14px;
    font-family: inherit;
  }

  .grafico-header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .grafico-subtitulo {
    margin: 0;
    font-size: 0.95rem;
    color: #4b5563;
    font-weight: 400;
  }

  .grafico-tooltip-bar {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.3rem 0.75rem;
    background: #eef5ff;
    color: #1d4ed8;
    border-radius: 999px;
    font-size: 0.84rem;
    font-weight: 500;
  }

  .info-sep {
    opacity: 0.5;
  }

  .grafico-area {
    position: relative;
    height: 270px;
    padding-left: 3.1rem;
    padding-bottom: 2.2rem;
    user-select: none;
  }

  /* Grid horizontal punteado */
  .eje-y-grid {
    position: absolute;
    inset: 0 0 2.2rem 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    pointer-events: none;
  }

  .linea-nivel {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    height: 0;
  }

  .etiqueta-y {
    width: 2.35rem;
    text-align: right;
    font-size: 0.85rem;
    color: #6b7280;
    font-variant-numeric: tabular-nums;
  }

  .linea-punteada {
    flex: 1;
    border-bottom: 1px dashed #e5e7eb;
  }

  /* Contenedor de barras */
  .barras-contenedor {
    position: relative;
    z-index: 1;
    height: 100%;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: clamp(0.65rem, 2.2vw, 1.5rem);
    align-items: end;
    padding: 0 0.5rem;
  }

  .barra-columna {
    appearance: none;
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    cursor: pointer;
    position: relative;
  }

  .barra-track {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }

  .barra-fill {
    width: 100%;
    max-width: 115px;
    background: #539bf5;
    border-radius: 10px;
    position: relative;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .barra-columna:hover .barra-fill,
  .barra-columna:focus-visible .barra-fill,
  .barra-columna.is-active .barra-fill {
    background: #3b82f6;
    transform: translateY(-2px);
  }

  .barra-valor-flotante {
    position: absolute;
    top: -1.55rem;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.8rem;
    font-weight: 600;
    color: #1f2937;
    opacity: 0;
    transition: opacity 0.18s ease;
    white-space: nowrap;
  }

  .barra-columna:hover .barra-valor-flotante,
  .barra-columna:focus-visible .barra-valor-flotante,
  .barra-columna.is-active .barra-valor-flotante {
    opacity: 1;
  }

  .etiqueta-x {
    position: absolute;
    bottom: -2rem;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.9rem;
    color: #1f2937;
    white-space: nowrap;
    font-weight: 400;
  }

  .barra-columna.is-active .etiqueta-x {
    font-weight: 600;
  }

  .grafico-fuente {
    margin-top: 1.35rem;
    padding-top: 0.85rem;
    border-top: 1px solid #eeeeee;
    font-size: 0.78rem;
    color: #6b7280;
  }

  @media (max-width: 600px) {
    .grafico-bcrp-wrapper {
      padding: 1.25rem 1rem 1rem;
    }

    .grafico-area {
      height: 230px;
      padding-left: 2.6rem;
    }

    .etiqueta-x {
      font-size: 0.76rem;
    }

    .barra-fill {
      border-radius: 7px;
    }
  }
</style>