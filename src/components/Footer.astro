<style>
  .site-footer {
    margin-top: 5rem;
    padding-top: 3.5rem;
    padding-bottom: 4rem;
    border-top: 1px solid rgba(160, 140, 100, 0.25);
    width: 100%;
  }

  .footer-container {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1.3fr 0.8fr;
    gap: 2.5rem;
    align-items: start;
  }

  .footer-name {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.8rem;
    line-height: 1.25;
  }

  .footer-desc {
    font-size: 0.88rem;
    color: var(--muted);
    line-height: 1.5;
    margin-bottom: 1.5rem;
    max-width: 280px;
  }

  .footer-copy {
    font-size: 0.78rem;
    color: var(--muted);
    line-height: 1.5;
    opacity: 0.8;
  }

  .footer-heading {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--text);
    margin-bottom: 1.2rem;
    text-transform: uppercase;
  }

  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .footer-links a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.2s ease;
  }

  .footer-links a:hover {
    color: var(--accent);
  }

  .contact-info {
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--text);
    margin-bottom: 0.8rem;
  }

  .contact-info .muted-text {
    font-size: 0.82rem;
    color: var(--muted);
  }

  .email-link {
    font-size: 0.88rem;
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: color 0.2s ease;
    word-break: break-all;
  }

  .email-link:hover {
    color: var(--accent);
  }

  .social-icons {
    display: flex;
    align-items: center;
    gap: 1.1rem;
  }

  .social-btn {
    color: var(--text);
    opacity: 0.85;
    transition: transform 0.2s ease, opacity 0.2s ease, color 0.2s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .social-btn:hover {
    opacity: 1;
    color: var(--accent);
    transform: translateY(-2px);
  }

  @media (max-width: 850px) {
    .footer-container {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem 1.5rem;
    }
  }

  @media (max-width: 500px) {
    .footer-container {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>