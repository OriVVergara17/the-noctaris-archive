---
import '../../styles/global.css';
import Header from '../../components/Header.astro';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <title>Contacto — Oriana Yadhira Vértiz Vergara (Noctaris)</title>
  </head>
  <body>

    <!-- CAPA DE FONDO: MARCA DE AGUA -->
    <div class="watermark-container" aria-hidden="true">
      <img src="/images/bg-art.png" class="watermark-bg-img" alt="" />
      <div class="watermark-text">NOCTARIS</div>
    </div>

    <!-- HEADER EN RETÍCULA -->
    <div class="header-full-screen">
      <Header />
    </div>

    <!-- CONTENEDOR PRINCIPAL -->
    <div class="content-wrapper">
      <main class="contact-page">
        <div class="contact-header">
          <span class="archive-no">ARCHIVE No. 003</span>
          <h1 class="contact-title" data-es="CORRESPONDENCIA & CONTACTO" data-en="CORRESPONDENCE & CONTACT">CORRESPONDENCIA & CONTACTO</h1>
          <p class="contact-subtitle"
             data-es="Para consultas académicas, análisis de políticas públicas, proyectos de investigación o colaboraciones editoriales."
             data-en="For academic inquiries, public policy analysis, research projects, or editorial collaborations.">
            Para consultas académicas, análisis de políticas públicas, proyectos de investigación o colaboraciones editoriales.
          </p>
        </div>

        <div class="correspondence-grid">
          <!-- COLUMNA IZQUIERDA: INFORMACIÓN DIRECTA -->
          <div class="info-card">
            <h2 class="card-heading" data-es="DESPACHO PRINCIPAL" data-en="MAIN DESK">DESPACHO PRINCIPAL</h2>
            
            <div class="info-group">
              <span class="info-label" data-es="AUTORA & ANALISTA" data-en="AUTHOR & ANALYST">AUTORA & ANALISTA</span>
              <p class="info-value">Oriana Yadhira Vértiz Vergara</p>
              <p class="info-sub">Alias · Noctaris</p>
            </div>

            <div class="info-group">
              <span class="info-label" data-es="CORREO ELECTRÓNICO" data-en="DIRECT EMAIL">CORREO ELECTRÓNICO</span>
              <a href="mailto:orianayvertizvergara@outlook.com" class="email-direct">
                orianayvertizvergara@outlook.com
              </a>
            </div>

            <div class="info-group">
              <span class="info-label" data-es="UBICACIÓN & ZONA HORARIA" data-en="LOCATION & TIMEZONE">UBICACIÓN & ZONA HORARIA</span>
              <p class="info-value">Perú · PET (UTC-5)</p>
            </div>

            <div class="seal-box">
              <span class="seal-icon">🏛️</span>
              <span class="seal-text" data-es="ARCHIVO PRIVADO · EDICIÓN 2026" data-en="PRIVATE ARCHIVE · 2026 EDITION">ARCHIVO PRIVADO · EDICIÓN 2026</span>
            </div>
          </div>

          <!-- COLUMNA DERECHA: FORMULARIO ESTILO CARTA -->
          <div class="letter-card">
            <div class="letter-header">
              <span class="letter-tag" data-es="MEMORÁNDUM / MISA" data-en="MEMORANDUM">MEMORÁNDUM</span>
              <span class="letter-date">2026</span>
            </div>

            <form action="https://formspree.io/f/xbjnqpyz" method="POST" class="letter-form">
              <div class="form-row">
                <div class="field-group">
                  <label for="name" data-es="REMITENTE (SU NOMBRE)" data-en="SENDER (YOUR NAME)">REMITENTE (SU NOMBRE)</label>
                  <input type="text" id="name" name="name" required placeholder="Ej. Gabriel Von Matt..." />
                </div>

                <div class="field-group">
                  <label for="email" data-es="DIRECCIÓN DE CORREO" data-en="EMAIL ADDRESS">DIRECCIÓN DE CORREO</label>
                  <input type="email" id="email" name="email" required placeholder="nombre@dominio.com" />
                </div>
              </div>

              <div class="field-group">
                <label for="subject" data-es="ASUNTO / MATERIA" data-en="SUBJECT / MATTER">ASUNTO / MATERIA</label>
                <input type="text" id="subject" name="subject" required placeholder="Colaboración académica, consulta..." />
              </div>

              <div class="field-group">
                <label for="message" data-es="MENSAJE / CARTA" data-en="MESSAGE / LETTER">MENSAJE / CARTA</label>
                <textarea id="message" name="message" rows="5" required placeholder="Escriba aquí los detalles de su correspondencia..."></textarea>
              </div>

              <div class="form-footer">
                <span class="form-note" data-es="* Su mensaje será recibido directamente en el despacho privado." data-en="* Your message will be received directly at the private desk.">* Su mensaje será recibido directamente en el despacho privado.</span>
                
                <button type="submit" class="submit-btn">
                  <span data-es="ENVIAR CARTA" data-en="SEND LETTER">ENVIAR CARTA</span>
                  <span class="btn-arrow">&rarr;</span>
                </button>
              </div>
            </form>
          </div>
        </div>
      </main>

      <!-- FOOTER -->
      <footer class="site-footer">
        <div class="footer-container">
          <div class="footer-col col-brand">
            <h2 class="footer-name">Oriana Yadhira Vértiz Vergara</h2>
            <p class="footer-desc">El archivo académico y de investigación de Oriana Yadhira Vértiz Vergara.</p>
            <p class="footer-copy">&copy; 2026 Oriana Yadhira Vértiz Vergara.<br />Todos los derechos reservados.</p>
          </div>
          <div class="footer-col">
            <h3 class="footer-heading">ENLACES RÁPIDOS</h3>
            <ul class="footer-links">
              <li><a href="/">Inicio</a></li>
              <li><a href="/ensayos">Ensayos</a></li>
              <li><a href="/biblioteca">Biblioteca</a></li>
              <li><a href="/cv">CV</a></li>
              <li><a href="/contacto">Contacto</a></li>
            </ul>
          </div>
          <div class="footer-col">
            <h3 class="footer-heading">CONTACTO</h3>
            <p class="contact-info">
              <strong>Oriana Yadhira Vértiz Vergara</strong><br />
              <span class="muted-text">Cientista Política & Analista Social</span>
            </p>
            <a href="mailto:orianayvertizvergara@outlook.com" class="email-link">orianayvertizvergara@outlook.com</a>
          </div>
          <div class="footer-col">
            <h3 class="footer-heading">CONECTAR</h3>
            <div class="social-icons">
              <a href="https://github.com/OriVVergara17" target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="GitHub">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg>
              </a>
              <a href="mailto:orianayvertizvergara@outlook.com" class="social-btn" aria-label="Email">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
              </a>
            </div>
          </div>
        </div>
      </footer>
    </div>

  </body>
</html>

<style is:global>
  .header-full-screen {
    width: 100% !important;
    position: relative !important;
    z-index: 100 !important;
  }

  .header-full-screen header {
    width: 100% !important;
    display: grid !important;
    grid-template-columns: 1fr auto 1fr !important;
    align-items: center !important;
    padding: 1.2rem 3.5rem !important;
    box-sizing: border-box !important;
  }

  .header-full-screen header > *:nth-child(1) { justify-self: start !important; }
  .header-full-screen header > *:nth-child(2) { justify-self: center !important; }
  .header-full-screen header > *:nth-child(3) { justify-self: end !important; }
</style>

<style>
  .content-wrapper {
    position: relative;
    z-index: 2;
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* Fondo atenuado e inamovible */
  .watermark-container {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .watermark-bg-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.08;
    filter: grayscale(100%) sepia(20%);
  }

  .watermark-text {
    position: absolute;
    bottom: -2vw;
    left: -1vw;
    font-family: 'Times New Roman', Times, Georgia, serif;
    font-size: clamp(8rem, 18vw, 22rem);
    color: var(--accent);
    opacity: 0.07;
    white-space: nowrap;
    user-select: none;
  }

  /* CABECERA */
  .contact-page {
    padding-top: 2rem;
    margin-bottom: 4rem;
  }

  .archive-no {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--muted);
  }

  .contact-title {
    font-family: var(--font-serif);
    font-size: 2.3rem;
    margin-top: 0.4rem;
    margin-bottom: 0.6rem;
    color: var(--text);
  }

  .contact-subtitle {
    font-size: 1.05rem;
    color: var(--muted);
    max-width: 620px;
    line-height: 1.5;
    margin-bottom: 2.8rem;
  }

  /* ESTRUCTURA GRID */
  .correspondence-grid {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 2.2rem;
    align-items: start;
  }

  /* COLUMNA IZQUIERDA - TARJETA DE INFORMACIÓN */
  .info-card {
    background: rgba(245, 240, 230, 0.4);
    border: 1px solid rgba(197, 160, 89, 0.35);
    border-radius: 14px;
    padding: 2rem;
    backdrop-filter: blur(6px);
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }

  .card-heading {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    letter-spacing: 0.06em;
    color: #c5a059;
    margin-bottom: 0.2rem;
  }

  .info-group {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .info-label {
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    color: var(--muted);
    font-weight: 600;
  }

  .info-value {
    font-size: 0.98rem;
    color: var(--text);
    font-weight: 500;
  }

  .info-sub {
    font-size: 0.8rem;
    color: var(--accent);
  }

  .email-direct {
    font-size: 0.88rem;
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 4px;
    word-break: break-all;
    transition: color 0.2s ease;
  }

  .email-direct:hover {
    color: #c5a059;
  }

  .seal-box {
    margin-top: 1rem;
    padding-top: 1.2rem;
    border-top: 1px dashed rgba(197, 160, 89, 0.3);
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .seal-icon {
    font-size: 1.2rem;
  }

  .seal-text {
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    color: var(--muted);
  }

  /* COLUMNA DERECHA - CARTA DE CORRESPONDENCIA */
  .letter-card {
    background: rgba(250, 247, 240, 0.65);
    border: 1px solid rgba(197, 160, 89, 0.45);
    border-radius: 16px;
    padding: 2.2rem;
    backdrop-filter: blur(8px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.03);
  }

  .letter-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid rgba(197, 160, 89, 0.25);
    padding-bottom: 0.8rem;
    margin-bottom: 1.8rem;
  }

  .letter-tag {
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    color: #c5a059;
    font-weight: 700;
  }

  .letter-date {
    font-size: 0.75rem;
    color: var(--muted);
    font-family: monospace;
  }

  .letter-form {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.2rem;
  }

  .field-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .field-group label {
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    color: var(--text);
    font-weight: 600;
  }

  .field-group input,
  .field-group textarea {
    width: 100%;
    background: rgba(255, 255, 255, 0.6);
    border: 1px solid rgba(197, 160, 89, 0.3);
    border-radius: 6px;
    padding: 0.75rem 0.9rem;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    color: var(--text);
    outline: none;
    box-sizing: border-box;
    transition: border-color 0.25s ease, background-color 0.25s ease;
  }

  .field-group input:focus,
  .field-group textarea:focus {
    border-color: #c5a059;
    background: rgba(255, 255, 255, 0.95);
  }

  .field-group textarea {
    resize: vertical;
    min-height: 120px;
  }

  .form-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 0.8rem;
    gap: 1rem;
  }

  .form-note {
    font-size: 0.72rem;
    color: var(--muted);
    font-style: italic;
  }

  /* BOTÓN ENVIAR CARTA */
  .submit-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: #c5a059;
    color: #ffffff;
    border: none;
    padding: 0.75rem 1.4rem;
    border-radius: 6px;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.25s ease, transform 0.2s ease;
  }

  .submit-btn:hover {
    background: #a8833d;
    transform: translateY(-2px);
  }

  .btn-arrow {
    font-size: 1rem;
    transition: transform 0.2s ease;
  }

  .submit-btn:hover .btn-arrow {
    transform: translateX(3px);
  }

  [data-theme="dark"] .info-card,
  [data-theme="dark"] .letter-card {
    background: rgba(25, 25, 25, 0.55);
    border-color: rgba(197, 160, 89, 0.25);
  }

  [data-theme="dark"] .field-group input,
  [data-theme="dark"] .field-group textarea {
    background: rgba(15, 15, 15, 0.6);
  }

  /* FOOTER */
  .site-footer {
    margin-top: 4rem;
    padding-top: 3rem;
    padding-bottom: 3rem;
    border-top: 1px solid rgba(160, 140, 100, 0.25);
  }

  .footer-container {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1.3fr 0.8fr;
    gap: 2rem;
  }

  .footer-name { font-family: var(--font-serif); font-size: 1.3rem; margin-bottom: 0.6rem; }
  .footer-desc, .footer-copy { font-size: 0.8rem; color: var(--muted); line-height: 1.4; }
  .footer-heading { font-size: 0.72rem; letter-spacing: 0.08em; margin-bottom: 1rem; }
  .footer-links { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 0.5rem; }
  .footer-links a { color: var(--muted); text-decoration: none; font-size: 0.85rem; }
  .contact-info { font-size: 0.85rem; }
  .email-link { font-size: 0.82rem; color: var(--text); text-decoration: underline; }
  .social-icons { display: flex; gap: 1rem; }
  .social-btn { color: var(--text); opacity: 0.8; }

  @media (max-width: 850px) {
    .correspondence-grid { grid-template-columns: 1fr; }
    .footer-container { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 550px) {
    .form-row { grid-template-columns: 1fr; }
    .form-footer { flex-direction: column; align-items: stretch; }
    .submit-btn { justify-content: center; }
    .footer-container { grid-template-columns: 1fr; }
  }
</style>