---
import '../styles/global.css';
import Header from '../components/Header.astro';
import { getCollection } from 'astro:content';
import miFoto from '../../public/images/mi-foto.png?url';
import frameImg from '../../public/images/frame.png?url';
import bgArt from '../../public/images/bg-art.png?url';
import cancionAudio from '../../public/audio/cancion.mp3?url';

// Obtener ensayos de la colección de contenidos
const todosLosEnsayos = await getCollection('ensayos');

// Filtrar los ensayos marcados como destacados (featured: true o destacado: true)
const destacados = todosLosEnsayos.filter(
  (ensayo) => ensayo.data.featured === true || ensayo.data.destacado === true
);

// Si hay proyectos destacados se usan los 2 primeros; si no, se muestran los 2 más recientes de la colección
const ensayosAMostrar = destacados.length > 0 ? destacados.slice(0, 2) : todosLosEnsayos.slice(0, 2);
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Oriana Yadhira Vértiz Vergara (Noctaris) — Private Archive</title>
  </head>
  <body>

    <!-- CAPA DE FONDO: MARCA DE AGUA CORREGIDA Y FORZADA -->
    <div class="watermark-container" aria-hidden="true" style="position: fixed !important; inset: 0 !important; width: 100vw !important; height: 100vh !important; pointer-events: none !important; z-index: 0 !important; overflow: hidden !important;">
      <img 
        src={bgArt} 
        alt="" 
        style="position: absolute !important; inset: 0 !important; width: 100% !important; height: 100% !important; object-fit: cover !important; opacity: 0.08 !important; mix-blend-mode: multiply !important; filter: grayscale(100%) contrast(105%) !important; pointer-events: none !important;" 
      />
      <div class="watermark-text">NOCTARIS</div>
    </div>

    <!-- HEADER CON RETÍCULA GRID DE 3 COLUMNAS -->
    <div class="header-full-screen">
      <Header />
    </div>

    <!-- CONTENEDOR PRINCIPAL -->
    <div class="content-wrapper">
      <main class="hero">
        <!-- COLUMNA IZQUIERDA: TEXTO Y ACCIONES -->
        <div class="left-col">
          <div class="archive-header">
            <span class="archive-no">ARCHIVE No. 001</span>
            <span class="pseudonym-tag">ALIAS · NOCTARIS</span>
          </div>

          <div class="hero-title">
            <h1>ORIANA YADHIRA<br />VÉRTIZ VERGARA</h1>
            <p class="tagline" 
               data-es="CIENTISTA POLÍTICA · ANALISTA POLÍTICA & SOCIAL · INVESTIGACIÓN"
               data-en="POLITICAL SCIENTIST · POLITICAL & SOCIAL ANALYST · RESEARCH">
              CIENTISTA POLÍTICA · ANALISTA POLÍTICA & SOCIAL · INVESTIGACIÓN
            </p>
          </div>

          <!-- REPRODUCTOR CÁPSULA DORADA -->
          <div class="vintage-audio-pill">
            <span class="pill-prefix">$ play</span>

            <button id="audio-toggle" class="pill-play-btn" type="button" aria-label="Reproducir pista">
              <svg id="play-icon" viewBox="0 0 24 24" width="12" height="12" fill="currentColor">
                <path d="M8 5v14l11-7z"/>
              </svg>
              <svg id="pause-icon" viewBox="0 0 24 24" width="12" height="12" fill="currentColor" style="display: none;">
                <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
              </svg>
            </button>

            <div class="sound-wave">
              <span></span><span></span><span></span><span></span><span></span><span></span><span></span>
            </div>

            <span class="pill-badge">NOCTARIS</span>
            <span class="pill-suffix">AMBIENCE</span>

            <audio id="hero-audio" src={cancionAudio}></audio>
          </div>

          <p class="quote"
             data-es="“Un archivo pensado para disecar las dinámicas del poder, desafiar los dogmas evidentes y mirar siempre más allá de la superficie.”"
             data-en="“An archive designed to dissect power dynamics, challenge self-evident dogmas, and always look beyond the surface.”">
            “Un archivo pensado para disecar las dinámicas del poder, desafiar los dogmas evidentes y mirar siempre más allá de la superficie.”
          </p>

          <div class="cta-row">
            <a href="/ensayos" class="btn" data-es="EXPLORAR ENSAYOS →" data-en="EXPLORE ESSAYS →">EXPLORAR ENSAYOS &rarr;</a>
            <span class="est">EST. 2026</span>
          </div>
        </div>

        <!-- COLUMNA DERECHA: MARCO BARROCO -->
        <div class="right-col">
          <div style="position: relative !important; width: 320px !important; height: 400px !important; flex-shrink: 0 !important; display: block !important;">
            
            <!-- Fotografía recortada y centrada al fondo -->
            <div style="position: absolute !important; top: 18% !important; left: 18% !important; width: 64% !important; height: 64% !important; overflow: hidden !important; z-index: 1 !important;"> 
              <img 
                src={miFoto} 
                alt="Oriana Yadhira Vértiz Vergara" 
                style="width: 100% !important; height: 100% !important; object-fit: cover !important; object-position: center !important; filter: grayscale(100%) contrast(105%) !important; display: block !important;" 
              />
            </div>

            <!-- Marco dorado encima con z-index superior -->
            <img 
              src={frameImg} 
              alt="" 
              style="position: absolute !important; top: 0 !important; left: 0 !important; width: 100% !important; height: 100% !important; object-fit: contain !important; z-index: 10 !important; pointer-events: none !important;" 
            />
          </div>

          <!-- ÍNDICE LATERAL -->
          <div class="index-numbers">
            <span class="num active">01</span>
            <span class="num">02</span>
            <span class="num">03</span>
            <span class="num">04</span>
            <span class="num">05</span>
          </div>
        </div>
      </main>

      <!-- SECCIÓN ACTIVIDAD EN GITHUB -->
      <section class="github-section">
        <h2 class="github-title" data-es="Github Activities:" data-en="Github Activities:">Github Activities:</h2>
        <div class="github-chart-card">
          <img 
            src="https://ghchart.rshah.org/c5a059/OriVVergara17" 
            alt="Actividad de GitHub de Oriana Vértiz" 
            class="github-chart"
            loading="lazy"
          />
        </div>
      </section>

      <!-- SECCIÓN PROYECTOS DESTACADOS -->
      <section class="featured-section">
        <div class="featured-header">
          <span class="featured-star">★</span>
          <h2 class="featured-title" data-es="DESTACADOS" data-en="FEATURED">DESTACADOS</h2>
        </div>

        <div class="featured-grid">
          {ensayosAMostrar.length > 0 ? (
            ensayosAMostrar.map((ensayo) => (
              <a href={`/ensayos/${ensayo.slug || ensayo.id}`} class="featured-card">
                <h3 class="card-title" data-es={ensayo.data.title} data-en={ensayo.data.titleEn || ensayo.data.title}>
                  {ensayo.data.title}
                </h3>

                <div class="card-meta">
                  <span class="meta-item">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                    {ensayo.data.date || ensayo.data.pubDate || '2026'}
                  </span>
                  <span class="meta-item">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 16 14"></polyline></svg>
                    {ensayo.data.readTime || ensayo.data.readingTime || '5 min lectura'}
                  </span>
                </div>

                <p class="card-desc" data-es={ensayo.data.description} data-en={ensayo.data.descriptionEn || ensayo.data.description}>
                  {ensayo.data.description}
                </p>

                <div class="card-tags">
                  {ensayo.data.tags && ensayo.data.tags.map((tag: string) => (
                    <span class="tag">{tag.startsWith('#') ? tag : `#${tag}`}</span>
                  ))}
                </div>
              </a>
            ))
          ) : (
            <>
              <!-- TARJETA 1 RESPALDO -->
              <a href={todosLosEnsayos[0] ? `/ensayos/${todosLosEnsayos[0].slug || todosLosEnsayos[0].id}` : '/ensayos'} class="featured-card">
                <h3 class="card-title" data-es="La Fragilidad en las Profundidades del Poder Político" data-en="The Fragility in the Depths of Political Power">
                  La Fragilidad en las Profundidades del Poder Político
                </h3>
                
                <div class="card-meta">
                  <span class="meta-item">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                    25 Feb, 2026
                  </span>
                  <span class="meta-item">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 16 14"></polyline></svg>
                    5 min lectura
                  </span>
                </div>

                <p class="card-desc" data-es="Un análisis riguroso sobre la vulnerabilidad institucional moderna, la crisis de legitimidad del Estado contemporáneo y las lecciones críticas de la historia política reciente." data-en="A rigorous analysis of modern institutional vulnerability, the contemporary crisis of state legitimacy, and critical lessons from recent political history.">
                  Un análisis riguroso sobre la vulnerabilidad institucional moderna, la crisis de legitimidad del Estado contemporáneo y las lecciones críticas de la historia política reciente.
                </p>

                <div class="card-tags">
                  <span class="tag">#CienciaPolítica</span>
                  <span class="tag">#Gobernanza</span>
                  <span class="tag">#AnálisisSocial</span>
                </div>
              </a>

              <!-- TARJETA 2 RESPALDO -->
              <a href={todosLosEnsayos[1] ? `/ensayos/${todosLosEnsayos[1].slug || todosLosEnsayos[1].id}` : '/ensayos'} class="featured-card">
                <h3 class="card-title" data-es="Burocracia Algorítmica: Redefiniendo el Estado en 2026" data-en="Algorithmic Bureaucracy: Redefining the State in 2026">
                  Burocracia Algorítmica: Redefiniendo el Estado en 2026
                </h3>

                <div class="card-meta">
                  <span class="meta-item">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                    18 Feb, 2026
                  </span>
                  <span class="meta-item">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 16 14"></polyline></svg>
                    3 min lectura
                  </span>
                </div>

                <p class="card-desc" data-es="Los sistemas automatizados han dejado de ser teoría futurista. Analizamos su arquitectura, casos de uso real en políticas públicas y sus implicaciones ético-sociales." data-en="Automated systems are no longer futuristic theory. We analyze their architecture, real use cases in public policy, and their ethical-social implications.">
                  Los sistemas automatizados han dejado de ser teoría futurista. Analizamos su arquitectura, casos de uso real en políticas públicas y sus implicaciones ético-sociales.
                </p>

                <div class="card-tags">
                  <span class="tag">#IA</span>
                  <span class="tag">#PolíticasPúblicas</span>
                  <span class="tag">#Tecnología</span>
                </div>
              </a>
            </>
          )}
        </div>
      </section>

      <!-- FOOTER AL FINAL DE LA PÁGINA -->
      <footer class="site-footer">
        <div class="footer-container">
          <!-- COLUMNA 1: NOMBRE & COPYRIGHT -->
          <div class="footer-col col-brand">
            <h2 class="footer-name">Oriana Yadhira Vértiz Vergara</h2>
            <p class="footer-desc" data-es="El archivo académico y de investigación de Oriana Yadhira Vértiz Vergara." data-en="The academic and research archive of Oriana Yadhira Vértiz Vergara.">
              El archivo académico y de investigación de Oriana Yadhira Vértiz Vergara.
            </p>
            <p class="footer-copy">
              &copy; 2026 Oriana Yadhira Vértiz Vergara.<br />
              <span data-es="Todos los derechos reservados." data-en="All rights reserved.">Todos los derechos reservados.</span>
            </p>
          </div>

          <!-- COLUMNA 2: ENLACES RÁPIDOS -->
          <div class="footer-col">
            <h3 class="footer-heading" data-es="ENLACES RÁPIDOS" data-en="QUICK LINKS">ENLACES RÁPIDOS</h3>
            <ul class="footer-links">
              <li><a href="#" data-es="Inicio" data-en="Home">Inicio</a></li>
              <li><a href="/ensayos" data-es="Ensayos" data-en="Essays">Ensayos</a></li>
              <li><a href="/biblioteca" data-es="Biblioteca" data-en="Library">Biblioteca</a></li>
              <li><a href="/cv" data-es="CV" data-en="CV">CV</a></li>
              <li><a href="/contacto" data-es="Contacto" data-en="Contact">Contacto</a></li>
            </ul>
          </div>

          <!-- COLUMNA 3: CONTACTO -->
          <div class="footer-col">
            <h3 class="footer-heading" data-es="CONTACTO" data-en="CONTACT">CONTACTO</h3>
            <p class="contact-info">
              <strong>Oriana Yadhira Vértiz Vergara</strong><br />
              <span class="muted-text" data-es="Cientista Política & Analista Social" data-en="Political Scientist & Social Analyst">Cientista Política & Analista Social</span>
            </p>
            <a href="mailto:orianayvertizvergara@outlook.com" class="email-link">
              orianayvertizvergara@outlook.com
            </a>
          </div>

          <!-- COLUMNA 4: REDES -->
          <div class="footer-col">
            <h3 class="footer-heading" data-es="CONECTAR" data-en="CONNECT">CONECTAR</h3>
            <div class="social-icons">
              <!-- GitHub -->
              <a href="https://github.com/OriVVergara17" target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="social-btn" title="GitHub">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
                  <path d="M9 18c-4.51 2-5-2-7-2"></path>
                </svg>
              </a>
              <!-- Email -->
              <a href="mailto:orianayvertizvergara@outlook.com" aria-label="Email" class="social-btn" title="Email">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                  <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                </svg>
              </a>
              <!-- LinkedIn -->
              <a href="https://www.linkedin.com/in/oriana-yadhira-v%C3%A9rtiz-vergara-805652410/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="social-btn" title="LinkedIn">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
                  <rect width="4" height="12" x="2" y="9"></rect>
                  <circle cx="4" cy="4" r="2"></circle>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </footer>
    </div>

    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const container = document.querySelector('.vintage-audio-pill');
        const audio = document.getElementById('hero-audio');
        const btn = document.getElementById('audio-toggle');
        const playIcon = document.getElementById('play-icon');
        const pauseIcon = document.getElementById('pause-icon');

        if (!(audio instanceof HTMLAudioElement) || !btn || !container || !playIcon || !pauseIcon) return;

        btn.addEventListener('click', () => {
          if (audio.paused) {
            audio.play();
            container.classList.add('is-playing');
            playIcon.style.display = 'none';
            pauseIcon.style.display = 'block';
          } else {
            audio.pause();
            container.classList.remove('is-playing');
            playIcon.style.display = 'block';
            pauseIcon.style.display = 'none';
          }
        });

        audio.addEventListener('ended', () => {
          container.classList.remove('is-playing');
          playIcon.style.display = 'block';
          pauseIcon.style.display = 'none';
        });
      });
    </script>
  </body>
</html>

<style is:global>
  /* HEADER & NAVEGACIÓN EN RETÍCULA DE 3 COLUMNAS */
  .header-full-screen {
    width: 100% !important;
    position: relative !important;
    z-index: 100 !important;
  }

  .header-full-screen header {
    width: 100% !important;
    max-width: 100% !important;
    display: grid !important;
    grid-template-columns: 1fr auto 1fr !important;
    align-items: center !important;
    padding: 1.2rem 3.5rem !important;
    box-sizing: border-box !important;
    position: relative !important;
  }

  .header-full-screen header * {
    position: static !important;
    transform: none !important;
  }

  .header-full-screen header > *:nth-child(1) { justify-self: start !important; }
  .header-full-screen header > *:nth-child(2) { justify-self: center !important; }
  .header-full-screen header > *:nth-child(3) { justify-self: end !important; }

  .header-full-screen nav ul,
  .header-full-screen header nav ul,
  .header-full-screen ul {
    display: flex !important;
    flex-direction: row !important;
    align-items: center !important;
    gap: 2rem !important;
    margin: 0 !important;
    padding: 0 !important;
    list-style: none !important;
  }

  /* ESTILOS DEL REPRODUCTOR CÁPSULA DORADA */
  .vintage-audio-pill {
    display: inline-flex !important;
    align-items: center !important;
    gap: 0.75rem !important;
    padding: 0.4rem 1rem !important;
    border: 1px solid #c5a059 !important;
    border-radius: 999px !important;
    background: rgba(245, 240, 230, 0.85) !important;
    box-shadow: 0 2px 10px rgba(197, 160, 89, 0.15) !important;
    margin: 0.2rem 0 !important;
    font-family: monospace, Courier, monospace !important;
    user-select: none !important;
    width: fit-content !important;
  }

  .pill-prefix {
    font-size: 0.75rem !important;
    color: #c5a059 !important;
    font-weight: 600 !important;
  }

  .pill-play-btn {
    width: 26px !important;
    height: 26px !important;
    border-radius: 50% !important;
    border: 1px solid #c5a059 !important;
    background: transparent !important;
    color: #c5a059 !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    cursor: pointer !important;
    padding: 0 !important;
    margin: 0 !important;
    line-height: 1 !important;
    transition: all 0.2s ease !important;
  }

  .pill-play-btn:hover {
    background: #c5a059 !important;
    color: #faf8f5 !important;
    transform: scale(1.05) !important;
  }

  .pill-play-btn svg {
    display: block !important;
  }

  .sound-wave {
    display: flex !important;
    align-items: center !important;
    gap: 3px !important;
    height: 12px !important;
  }

  .sound-wave span {
    display: block !important;
    width: 3px !important;
    height: 4px !important;
    background-color: rgba(197, 160, 89, 0.4) !important;
    border-radius: 2px !important;
    transition: all 0.3s ease !important;
  }

  .vintage-audio-pill.is-playing .sound-wave span {
    background-color: #c5a059 !important;
    animation: wavePulse 1s infinite ease-in-out alternate !important;
  }

  .vintage-audio-pill.is-playing .sound-wave span:nth-child(1) { animation-delay: 0.1s !important; }
  .vintage-audio-pill.is-playing .sound-wave span:nth-child(2) { animation-delay: 0.3s !important; }
  .vintage-audio-pill.is-playing .sound-wave span:nth-child(3) { animation-delay: 0.2s !important; }
  .vintage-audio-pill.is-playing .sound-wave span:nth-child(4) { animation-delay: 0.5s !important; }
  .vintage-audio-pill.is-playing .sound-wave span:nth-child(5) { animation-delay: 0.1s !important; }
  .vintage-audio-pill.is-playing .sound-wave span:nth-child(6) { animation-delay: 0.4s !important; }
  .vintage-audio-pill.is-playing .sound-wave span:nth-child(7) { animation-delay: 0.2s !important; }

  @keyframes wavePulse {
    0% { height: 3px; }
    100% { height: 12px; }
  }

  .pill-badge {
    border: 1px solid rgba(197, 160, 89, 0.6) !important;
    border-radius: 999px !important;
    padding: 0.12rem 0.5rem !important;
    font-size: 0.62rem !important;
    font-weight: 700 !important;
    color: #2b2622 !important;
    background: rgba(197, 160, 89, 0.15) !important;
    text-transform: uppercase !important;
    letter-spacing: 0.08em !important;
  }

  .pill-suffix {
    font-size: 0.65rem !important;
    color: #8c8275 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.08em !important;
  }
</style>

<style>
  /* 1. ESTRUCTURA PANTALLA COMPLETA */
  html, body {
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
    overflow-x: hidden !important;
  }

  .content-wrapper {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 4rem;
    box-sizing: border-box;
  }

  .watermark-text {
    position: absolute;
    bottom: -2vw;
    left: -1vw;
