---
import '../../styles/global.css';
import Header from '../../components/Header.astro';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <title>CV — Oriana Yadhira Vértiz Vergara</title>
  </head>
  <body>
    <div class="header-full-screen">
      <Header />
    </div>

    <main class="content-wrapper">
      <section class="page-intro">
        <span class="archive-no">ARCHIVE No. 003</span>
        <h1 class="page-title">CURRICULUM VITAE</h1>
        <p class="page-desc">Sección en actualización. El documento estará disponible próximamente.</p>
      </section>
    </main>
  </body>
</html>

<style>
  .content-wrapper {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem;
  }
  .page-intro {
    padding-top: 2rem;
  }
  .archive-no {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .page-title {
    font-family: var(--font-serif);
    font-size: 2.4rem;
    margin-top: 0.4rem;
    margin-bottom: 0.6rem;
    color: var(--text);
  }
  .page-desc {
    font-size: 1.05rem;
    color: var(--muted);
  }
</style>