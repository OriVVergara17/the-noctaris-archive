---
import '../../styles/global.css';
import Header from '../../components/Header.astro';

// Datos de películas, libros y canciones
const items = [
  {
    title: "1984",
    creator: "George Orwell",
    type: "libros",
    year: "1949",
    category: "Novela Distópica",
    desc: "Un análisis fundamental sobre la vigilancia estatal, la manipulación de la verdad y el control de la información.",
    cover: "https://images.unsplash.com/photo-1544716278-ca5e3f4abd8c?q=80&w=600&auto=format&fit=crop"
  },
  {
    title: "Oppenheimer",
    creator: "Christopher Nolan",
    type: "peliculas",
    year: "2023",
    category: "Biopic / Historia",
    desc: "Exploración de la ética, el dilema científico y la responsabilidad geopolítica tras la creación de las armas nucleares.",
    cover: "https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?q=80&w=600&auto=format&fit=crop"
  },
  {
    title: "Time",
    creator: "Pink Floyd",
    type: "canciones",
    year: "1973",
    category: "Rock Progresivo",
    desc: "Una reflexión lírica e instrumental sobre el paso ineludible del tiempo y las oportunidades perdidas.",
    cover: "https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?q=80&w=600&auto=format&fit=crop"
  },
  {
    title: "El Leviatán",
    creator: "Thomas Hobbes",
    type: "libros",
    year: "1651",
    category: "Filosofía Política",
    desc: "Fundamento del contrato social y la necesidad del Estado para evitar el caos de la condición natural.",
    cover: "https://images.unsplash.com/photo-1532012197267-da84d127e765?q=80&w=600&auto=format&fit=crop"
  }
];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <title>Biblioteca — Oriana Yadhira Vértiz Vergara (Noctaris)</title>
  </head>
  <body>

    <!-- FONDO Y MARCA DE AGUA -->
    <div class="watermark-container" aria-hidden="true">
      <img src="/images/bg-art.png" class="watermark-bg-img" alt="" />
      <div class="watermark-text">NOCTARIS</div>
    </div>

    <!-- HEADER FLUIDO EN 3 COLUMNAS -->
    <div class="header-full-screen">
      <Header />
    </div>

    <div class="content-wrapper">
      <!-- CABECERA DE LA PÁGINA -->
      <section class="page-intro">
        <span class="archive-no">ARCHIVE No. 002</span>
        <h1 class="page-title" data-es="BIBLIOTECA & MEDIOS" data-en="LIBRARY & MEDIA">BIBLIOTECA & MEDIOS</h1>
        <p class="page-desc" 
           data-es="Una colección curada de lecturas, filmografía y piezas musicales que alimentan mi análisis político y visión crítica del mundo."
           data-en="A curated collection of readings, films, and music pieces shaping my political analysis and critical world view.">
          Una colección curada de lecturas, filmografía y piezas musicales que alimentan mi análisis político y visión crítica del mundo.
        </p>
      </section>

      <!-- BARRA DE PESTAÑAS (FILTROS) -->
      <div class="filter-bar">
        <button class="filter-btn active" data-filter="todos" data-es="TODOS" data-en="ALL">TODOS</button>
        <button class="filter-btn" data-filter="libros" data-es="LIBROS" data-en="BOOKS">LIBROS</button>
        <button class="filter-btn" data-filter="peliculas" data-es="PELÍCULAS" data-en="MOVIES">PELÍCULAS</button>
        <button class="filter-btn" data-filter="canciones" data-es="CANCIONES" data-en="SONGS">CANCIONES</button>
      </div>

      <!-- GRID DE ELEMENTOS -->
      <section class="media-grid">
        {items.map((item) => (
          <article class="media-card" data-category={item.type}>
            <div class="cover-wrapper">
              <img src={item.cover} alt={item.title} loading="lazy" />
              <span class="type-badge">{item.type.toUpperCase()}</span>
            </div>
            
            <div class="card-content">
              <div class="card-header-row">
                <h3 class="item-title">{item.title}</h3>
                <span class="item-year">{item.year}</span>
              </div>
              <p class="item-creator">{item.creator}</p>
              <p class="item-desc">{item.desc}</p>
              <span class="tag">#{item.category.replace(/\s+/g, '')}</span>
            </div>
          </article>
        ))}
      </section>

      <!-- FOOTER -->
      <footer class="site-footer">
        <div class="footer-container">
          <div class="footer-col col-brand">
            <h2 class="footer-name">Oriana Yadhira Vértiz Vergara</h2>
            <p class="footer-desc">El archivo académico y de investigación de Oriana Yadhira Vértiz Vergara.</p>
            <p class="footer-copy">&copy; 2026 Oriana Yadhira Vértiz Vergara.<br />Todos los derechos reservados.</p>
          </div>
          <div class="footer-col">
            <h3 class="footer-heading">ENLACES RÁPIDOS</h3>
            <ul class="footer-links">
              <li><a href="/">Inicio</a></li>
              <li><a href="/ensayos">Ensayos</a></li>
              <li><a href="/biblioteca">Biblioteca</a></li>
              <li><a href="/cv">CV</a></li>
              <li><a href="/contacto">Contacto</a></li>
            </ul>
          </div>
          <div class="footer-col">
            <h3 class="footer-heading">CONTACTO</h3>
            <p class="contact-info">
              <strong>Oriana Yadhira Vértiz Vergara</strong><br />
              <span class="muted-text">Cientista Política & Analista Social</span>
            </p>
            <a href="mailto:orianayvertizvergara@outlook.com" class="email-link">orianayvertizvergara@outlook.com</a>
          </div>
          <div class="footer-col">
            <h3 class="footer-heading">CONECTAR</h3>
            <div class="social-icons">
              <a href="https://github.com/OriVVergara17" target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="GitHub">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg>
              </a>
              <a href="mailto:orianayvertizvergara@outlook.com" class="social-btn" aria-label="Email">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
              </a>
            </div>
          </div>
        </div>
      </footer>
    </div>

    <!-- LÓGICA JAVASCRIPT PARA EL FILTRADO INTERACTIVO -->
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const filterBtns = document.querySelectorAll('.filter-btn');
        const mediaCards = document.querySelectorAll('.media-card');

        filterBtns.forEach(btn => {
          btn.addEventListener('click', () => {
            filterBtns.forEach(b => b.classList.remove('active'));
            btn.classList.add('active');

            const filterValue = btn.getAttribute('data-filter');

            mediaCards.forEach(card => {
              const category = card.getAttribute('data-category');
              if (filterValue === 'todos' || filterValue === category) {
                (card as HTMLElement).style.display = 'flex';
              } else {
                (card as HTMLElement).style.display = 'none';
              }
            });
          });
        });
      });
    </script>
  </body>
</html>

<style is:global>
  .header-full-screen {
    width: 100% !important;
    position: relative !important;
    z-index: 100 !important;
  }

  .header-full-screen header {
    width: 100% !important;
    display: grid !important;
    grid-template-columns: 1fr auto 1fr !important;
    align-items: center !important;
    padding: 1.2rem 3.5rem !important;
    box-sizing: border-box !important;
  }

  .header-full-screen header > *:nth-child(1) { justify-self: start !important; }
  .header-full-screen header > *:nth-child(2) { justify-self: center !important; }
  .header-full-screen header > *:nth-child(3) { justify-self: end !important; }
</style>

<style>
  .content-wrapper {
    position: relative;
    z-index: 2;
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* Fondo atenuado */
  .watermark-container {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .watermark-bg-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.08;
    filter: grayscale(100%) sepia(20%);
  }

  .watermark-text {
    position: absolute;
    bottom: -2vw;
    left: -1vw;
    font-family: 'Times New Roman', Times, Georgia, serif;
    font-size: clamp(8rem, 18vw, 22rem);
    color: var(--accent);
    opacity: 0.07;
    white-space: nowrap;
    user-select: none;
  }

  .page-intro {
    padding-top: 2rem;
    margin-bottom: 2rem;
  }

  .archive-no {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--muted);
  }

  .page-title {
    font-family: var(--font-serif);
    font-size: 2.4rem;
    margin-top: 0.4rem;
    margin-bottom: 0.6rem;
    color: var(--text);
  }

  .page-desc {
    font-size: 1.05rem;
    color: var(--muted);
    max-width: 650px;
    line-height: 1.5;
  }

  /* BOTONES DE FILTRO ESTILO TABS */
  .filter-bar {
    display: flex;
    gap: 0.8rem;
    margin-bottom: 2.5rem;
    border-bottom: 1px solid rgba(197, 160, 89, 0.25);
    padding-bottom: 0.8rem;
  }

  .filter-btn {
    background: transparent;
    border: 1px solid transparent;
    padding: 0.4rem 0.9rem;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--muted);
    cursor: pointer;
    border-radius: 4px;
    transition: all 0.2s ease;
  }

  .filter-btn:hover {
    color: var(--accent);
  }

  .filter-btn.active {
    background: rgba(197, 160, 89, 0.15);
    border-color: #c5a059;
    color: #c5a059;
    font-weight: 600;
  }

  /* TARJETAS DE MEDIOS */
  .media-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.8rem;
    margin-bottom: 4rem;
  }

  .media-card {
    display: flex;
    gap: 1.2rem;
    padding: 1.2rem;
    background: rgba(245, 240, 230, 0.35);
    border: 1px solid rgba(197, 160, 89, 0.35);
    border-radius: 14px;
    backdrop-filter: blur(6px);
    transition: transform 0.25s ease, border-color 0.25s ease;
  }

  .media-card:hover {
    transform: translateY(-3px);
    border-color: #c5a059;
  }

  .cover-wrapper {
    position: relative;
    width: 110px;
    height: 150px;
    flex-shrink: 0;
    border-radius: 8px;
    overflow: hidden;
    background: #111;
  }

  .cover-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(30%);
    transition: filter 0.3s ease;
  }

  .media-card:hover .cover-wrapper img {
    filter: grayscale(0%);
  }

  .type-badge {
    position: absolute;
    bottom: 6px;
    left: 6px;
    background: rgba(0, 0, 0, 0.75);
    color: #c5a059;
    font-size: 0.58rem;
    padding: 0.15rem 0.4rem;
    border-radius: 3px;
    letter-spacing: 0.05em;
  }

  .card-content {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 100%;
  }

  .card-header-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
  }

  .item-title {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--text);
  }

  .item-year {
    font-size: 0.75rem;
    color: var(--muted);
  }

  .item-creator {
    font-size: 0.82rem;
    color: var(--accent);
    font-weight: 500;
    margin-bottom: 0.4rem;
  }

  .item-desc {
    font-size: 0.85rem;
    color: var(--muted);
    line-height: 1.45;
    margin-bottom: 0.8rem;
  }

  .tag {
    font-size: 0.7rem;
    color: #8c6d37;
    align-self: flex-start;
  }

  [data-theme="dark"] .media-card {
    background: rgba(25, 25, 25, 0.5);
    border-color: rgba(197, 160, 89, 0.25);
  }

  /* FOOTER */
  .site-footer {
    margin-top: 4rem;
    padding-top: 3rem;
    padding-bottom: 3rem;
    border-top: 1px solid rgba(160, 140, 100, 0.25);
  }

  .footer-container {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1.3fr 0.8fr;
    gap: 2rem;
  }

  .footer-name { font-family: var(--font-serif); font-size: 1.3rem; margin-bottom: 0.6rem; }
  .footer-desc, .footer-copy { font-size: 0.8rem; color: var(--muted); line-height: 1.4; }
  .footer-heading { font-size: 0.72rem; letter-spacing: 0.08em; margin-bottom: 1rem; }
  .footer-links { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 0.5rem; }
  .footer-links a { color: var(--muted); text-decoration: none; font-size: 0.85rem; }
  .contact-info { font-size: 0.85rem; }
  .email-link { font-size: 0.82rem; color: var(--text); text-decoration: underline; }
  .social-icons { display: flex; gap: 1rem; }
  .social-btn { color: var(--text); opacity: 0.8; }

  @media (max-width: 768px) {
    .media-grid { grid-template-columns: 1fr; }
    .footer-container { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 500px) {
    .media-card { flex-direction: column; }
    .cover-wrapper { width: 100%; height: 180px; }
    .footer-container { grid-template-columns: 1fr; }
  }
</style>